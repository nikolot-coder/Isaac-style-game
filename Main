BASE_WINDOW_WIDTH = 1280
BASE_WINDOW_HEIGHT = 720
WINDOW_WIDTH = BASE_WINDOW_WIDTH
WINDOW_HEIGHT = BASE_WINDOW_HEIGHT
FPS = 60

def ui_scale():
    return max(0.75, min(WINDOW_WIDTH / BASE_WINDOW_WIDTH, WINDOW_HEIGHT / BASE_WINDOW_HEIGHT))

def scaled(value):
    return max(1, int(value * ui_scale()))

def center_window():
    try:
        hwnd = pygame.display.get_wm_info().get("window")
        if not hwnd:
            return
        screen_w = ctypes.windll.user32.GetSystemMetrics(0)
        screen_h = ctypes.windll.user32.GetSystemMetrics(1)
        x = max(0, (screen_w - WINDOW_WIDTH) // 2)
        y = max(0, (screen_h - WINDOW_HEIGHT) // 2)
        ctypes.windll.user32.SetWindowPos(hwnd, 0, x, y, 0, 0, 0x0001 | 0x0004 | 0x0010)
    except:
        pass

def make_fullscreen():
    global window, WINDOW_WIDTH, WINDOW_HEIGHT
    WINDOW_WIDTH = ctypes.windll.user32.GetSystemMetrics(0)
    WINDOW_HEIGHT = ctypes.windll.user32.GetSystemMetrics(1)
    window = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.NOFRAME)
    try:
        hwnd = pygame.display.get_wm_info().get("window")
        if hwnd:
            ctypes.windll.user32.SetWindowPos(hwnd, 0, 0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, 0x0004 | 0x0010)
    except:
        pass

window = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
center_window()
effect_surface = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.SRCALPHA)
pygame.display.set_caption("Isaac - Style Game")
clock = pygame.time.Clock()
bullet_glow_cache = {}
show_inventory = False
bullets = []
room_intro_active = False
room_intro_timer = 0
room_intro_text = ""
room_intro_boss = None
room_intro_last_char = 0

def start_room_intro(boss):
    global room_intro_active, room_intro_timer, room_intro_boss, room_intro_text, room_intro_last_char

    room_intro_active = True
    room_intro_timer = 0
    room_intro_boss = boss
    room_intro_last_char = 0

    lang = settings.get("language", "English")

    if lang == "Polski":
        room_intro_text = "Wybranie Nvidii było twoim błędem"
    elif lang == "Japanese":
        room_intro_text = "NVIDIAを選んだのはお前の間違いだ"
    else:
        room_intro_text = "Choosing Nvidia was your mistake"

def draw_room_intro(surface):
    global room_intro_timer, room_intro_last_char

    room_intro_timer += 1

    alpha = min(180, room_intro_timer * 3)

    overlay = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, alpha))

    pygame.draw.rect(overlay, (0, 0, 0), (0, 0, WINDOW_WIDTH, scaled(120)))
    pygame.draw.rect(overlay, (0, 0, 0), (0, WINDOW_HEIGHT-scaled(120), WINDOW_WIDTH, scaled(120)))

    surface.blit(overlay, (0, 0))

    if room_intro_boss:
        bx = WINDOW_WIDTH//2
        by = scaled(120)
        surface.blit(room_intro_boss.image, (bx - 60, by))

    font = pygame.font.SysFont("comicsansms", scaled(30))
    hint_font = pygame.font.SysFont("comicsansms", scaled(24))
    chars = min(len(room_intro_text), room_intro_timer // 4)
    text = room_intro_text[:chars]
    if chars > room_intro_last_char:
        play_sound("talk")
    room_intro_last_char = chars

    txt_surf = font.render(text, True, (255, 255, 255))
    surface.blit(txt_surf, (WINDOW_WIDTH//2 - txt_surf.get_width()//2, WINDOW_HEIGHT//2))
    if chars >= len(room_intro_text):
        hint = hint_font.render("Press SPACE to continue", True, (255, 220, 120))
        surface.blit(hint, (WINDOW_WIDTH//2 - hint.get_width()//2, WINDOW_HEIGHT//2 + scaled(48)))

def tr(key):
    lang = settings.get("language", "English")
    return LANG.get(lang, LANG["English"]).get(key, key)

def tr_item(name):
    lang = settings.get("language", "English")
    return ITEM_LANG.get(lang, {}).get(name, [name, ""])

def get_powerup_def(name):
    for item in POWERUP_DEFS:
        if item["name"] == name:
            return item
    return None

def get_synergy_desc(name):
    for data in SYNERGIES.values():
        if data["name"] == name:
            return data.get("effect", "")
    return ""

def wrap_text(text, font, max_width):
    words = text.split()
    lines = []
    current = ""
    for word in words:
        trial = word if not current else current + " " + word
        if font.size(trial)[0] <= max_width:
            current = trial
        else:
            if current:
                lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines

