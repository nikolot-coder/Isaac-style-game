    pass

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
def img_path(rel): return os.path.join(BASE_DIR, rel)

SETTINGS_FILE = "settings.json"
SAVE_FILE = "savegame.json"
settings = {"language": "English", "gamma": 1.0, "window_scale": 1.0, "music_volume": 0.5, "sfx_volume": 0.5, "dev_keys_enabled": False}

def load_sound(rel):
    if not pygame.mixer.get_init():
        return None
    try:
        sound = pygame.mixer.Sound(img_path(rel))
        sound.set_volume(settings["sfx_volume"])
        return sound
    except:
        return None

sounds = {
    "talk": load_sound(".vscode/Sounds/talk.mp3"),
    "shoot": load_sound(".vscode/Sounds/shoot.wav"),
    "hit": load_sound(".vscode/Sounds/hit.wav"),
    "die": load_sound(".vscode/Sounds/die.wav"),
    "explode": [
        load_sound(".vscode/Sounds/explode0.wav"),
        load_sound(".vscode/Sounds/explode1.wav"),
        load_sound(".vscode/Sounds/explode2.wav")
    ]
}
music_loaded = False

def start_background_music():
    global music_loaded
    if not pygame.mixer.get_init():
        return
    try:
        if not music_loaded:
            pygame.mixer.music.load(img_path(".vscode/Sounds/tetraneo threat theme.mp3"))
            music_loaded = True
        pygame.mixer.music.set_volume(settings["music_volume"])
        if not pygame.mixer.music.get_busy():
            pygame.mixer.music.play(-1)
    except:
        music_loaded = False

def update_sfx_volume():
    for name,sound in sounds.items():
        volume = min(1.0, settings["sfx_volume"] * 1.45) if name=="explode" else settings["sfx_volume"]
        if isinstance(sound, list):
            for item in sound:
                if item:
                    item.set_volume(volume)
        elif sound:
            sound.set_volume(volume)

def play_sound(name):
    sound = sounds.get(name)
    if isinstance(sound, list):
        sound = choice([item for item in sound if item] or [None])
    if sound:
        sound.play()
