    ("Wind Force", "Storm Arsenal"): {
        "name": "LEGENDARY: Celestial Foundry",
        "effect": "Legendary ranged ascension from two synergies: massive health, bullet speed, and slash backup.",
        "legendary": True,
        "apply": synergy_legend_celestial_foundry
    },
    ("APOCALYPSE CORE", "Crimson Engine"): {
        "name": "LEGENDARY: Void Ascension",
        "effect": "Legendary blood build from two synergies: extreme speed, damage, and stronger healing on kills.",
        "legendary": True,
        "apply": synergy_legend_void_ascension
    }
}

def make_placeholder_powerup(color):
    surf = pygame.Surface((48, 48), pygame.SRCALPHA)
    pygame.draw.circle(surf, color, (24, 24), 22)
    pygame.draw.circle(surf, (255, 255, 255), (24, 24), 22, 3)
    font = pygame.font.SysFont("arial", 22, bold=True)
    t = font.render("?", True, (255, 255, 255))
    surf.blit(t, (24 - t.get_width()//2, 24 - t.get_height()//2))
    return surf

def load_powerup_images():
    images = {}
    for p in POWERUP_DEFS:
        i = p["id"]
        try:
            img = pygame.image.load(img_path(f".vscode/Images/powerup{i}.png")).convert_alpha()
            img = pygame.transform.scale(img, (48, 48))
        except:
            img = make_placeholder_powerup(p["color"])
        images[i] = img
    return images

POWERUP_IMAGES = load_powerup_images()

class PowerupItem:
    PICKUP_RADIUS = 52
    def __init__(self, x, y, powerup_def):
        self.x = x; self.y = y
        self.defn = powerup_def
        self.rect = pygame.Rect(x-24, y-24, 48, 48)
        self.bob_timer = randint(0, 628)
        self.alive = True

    def update(self):
        self.bob_timer += 3

    def near_player(self, player):
        cx = player.x + player.width//2
        cy = player.y + player.height//2
        return ((cx-self.x)**2 + (cy-self.y)**2)**0.5 < self.PICKUP_RADIUS

    def apply(self, player):
        pid = self.defn["id"]
        player.add_item(self.defn["name"])
        if pid == 0:
            player.max_hp += 3
            player.hp = player.max_hp
            player.speed *= 0.95
        elif pid == 1:
            player.speed *= 1.25
            player.invincibility_frames = max(25, player.invincibility_frames - 10)
        elif pid == 2:
            player.bullet_speed *= 1.3
            player.speed *= 0.95
        elif pid == 3:
            player.extra_shot = True
            player.reload_duration += 5
        elif pid == 4:
            player.invincibility_frames += 35
            player.speed *= 0.9
        elif pid == 5:
            player.reload_duration = max(25, int(player.reload_duration * 0.65))
            player.max_hp = max(1, player.max_hp - 1)
            player.hp = min(player.hp, player.max_hp)
        elif pid == 6:
            player.slash_range += 35
            player.slash_damage += 1
            player.bullet_speed *= 0.9
        elif pid == 7:
            player.max_ammo += 5
            player.ammo = player.max_ammo
            player.reload_duration += 10
        elif pid == 8:
            player.max_hp = max(1, player.max_hp - 1)
            player.hp = min(player.hp, player.max_hp)
            player.slash_damage += 2
        elif pid == 9:
            player.speed += 0.5
            player.invincibility_frames = max(30, player.invincibility_frames - 15)
        elif pid == 10:
            player.blood_pact = True
            player.heal_on_kill = True
            player.heal_on_kill_amount = max(player.heal_on_kill_amount, 1)
            player.max_hp = max(2, player.max_hp - 1)
            player.hp = min(player.hp, player.max_hp)
        elif pid == 11:
            player.frost = True
            player.bullet_speed *= 0.8
            player.speed *= 0.95
        elif pid == 12:
            player.max_ammo += 4
            player.bullet_damage_penalty = True
            player.slash_damage -= 1
        elif pid == 13:
            player.chaos = True
            player.speed *= 1.05
            player.invincibility_frames = max(20, player.invincibility_frames - 20)
        elif pid == 14:
            player.blood_pact = True
            player.heal_on_kill = True
            player.heal_on_kill_amount = max(player.heal_on_kill_amount, 2)
            player.slash_damage += 1
            player.max_hp = max(2, player.max_hp - 1)
            player.hp = min(player.max_hp, player.hp + 1)
        elif pid == 15:
            player.bullet_speed *= 1.45
            player.max_ammo += 2
            player.ammo = player.max_ammo
            player.reload_duration += 20
        elif pid == 16:
            player.max_hp += 4
            player.hp = player.max_hp
            player.invincibility_frames += 25
            player.speed *= 0.85
        self.alive = False

    def draw(self, surface, font_small, font_desc):
        bob = math.sin(self.bob_timer * 0.04) * 5
        draw_y = int(self.y + bob)
        surface.blit(POWERUP_IMAGES[self.defn["id"]], (self.x-24, draw_y-24))
        pygame.draw.ellipse(surface, (80,60,100), (self.x-18, draw_y+22, 36, 10))

    def draw_description(self, surface, font_name, font_desc):
        bob = math.sin(self.bob_timer * 0.04) * 5
        cx = self.x; top_y = int(self.y + bob) - 80
        iname,idesc=tr_item(self.defn["name"])
        if not idesc:
            idesc = self.defn["desc"]
        name_surf=font_name.render(iname,True,(255,240,180))
        desc_surf=font_desc.render(idesc,True,(200,200,200))
        pad = 10
        bw = max(name_surf.get_width(), desc_surf.get_width()) + pad*2
        bh = name_surf.get_height() + desc_surf.get_height() + pad*2 + 4
        bx = cx - bw//2; by = top_y - bh
        bg = pygame.Surface((bw, bh), pygame.SRCALPHA)
        bg.fill((20,10,30,200))
        pygame.draw.rect(bg, (180,120,255,180), (0,0,bw,bh), 2)
        surface.blit(bg, (bx, by))
        surface.blit(name_surf, (bx+pad, by+pad))
        surface.blit(desc_surf, (bx+pad, by+pad+name_surf.get_height()+4))

def get_glow_surface(radius, alpha):
    key = (radius, alpha)
    if key not in bullet_glow_cache:
        gs = pygame.Surface((radius*4, radius*4), pygame.SRCALPHA)
        pygame.draw.circle(gs, (255,220,100,alpha), (radius*2, radius*2), radius)
        bullet_glow_cache[key] = gs
    return bullet_glow_cache[key]

class Enemy:
    def __init__(self, x, y):
        self.memory_timer = 0
        self.player_style = "neutral"
        self.aggression = 1.0
        self.hp = 3; self.x = x; self.y = y
        self.width = 40; self.height = 40; self.speed = 2
        self.rect = pygame.Rect(self.x, self.y, self.width, self.height)
        self.move_x = 0; self.move_y = 0
        self.ai_timer = randint(20, 80)
        self.state = choice(["chase","strafe_left","strafe_right","retreat"])
        self.dash_timer = randint(120, 240)
        self.preferred_distance = 120
        self.state_weights = ["chase","chase","chase","strafe_left","strafe_right","retreat"]
        self.learned_styles = {"ranged":0,"melee":0,"kiter":0,"balanced":0,"neutral":0}

    def choose_new_state(self):
        self.state = choice(self.state_weights)
        self.ai_timer = randint(25, 90)
    def learn(self, player):
        self.player_style = get_player_style(player)
        self.learned_styles[self.player_style] = self.learned_styles.get(self.player_style, 0) + 1

        if self.player_style == "ranged":
            self.aggression = 1.3
            self.speed = 2.4
            self.preferred_distance = 90
            self.state_weights = ["chase","chase","strafe_left","strafe_right","strafe_right"]

        elif self.player_style == "melee":
            self.aggression = 0.8
            self.speed = 2.0
            self.preferred_distance = 170
            self.state_weights = ["retreat","retreat","strafe_left","strafe_right","chase"]

        elif self.player_style == "kiter":
            self.aggression = 1.1
            self.speed = 2.6
            self.preferred_distance = 70
            self.state_weights = ["chase","chase","chase","chase","strafe_left","strafe_right"]

        else:
            self.aggression = 1.0
            self.speed = 2.2
            self.preferred_distance = 120
            self.state_weights = ["chase","chase","strafe_left","strafe_right","retreat"]

    def update(self, player,):
        self.memory_timer += 1
        if self.memory_timer % FPS == 0:
            self.learn(player)
        self.ai_timer -= 1; self.dash_timer -= 1
        if self.ai_timer <= 0: self.choose_new_state()
        dx = player.x-self.x; dy = player.y-self.y
        dist = max((dx**2+dy**2)**0.5, 1)
        nx = dx/dist; ny = dy/dist
        if dist < self.preferred_distance * 0.7:
            self.state = "retreat"
        elif dist > self.preferred_distance * 1.8 and self.player_style in ["ranged","kiter"]:
            self.state = "chase"
        if self.state == "chase":          self.move_x += nx*0.4;  self.move_y += ny*0.4
        elif self.state == "strafe_left":  self.move_x += -ny*0.5; self.move_y += nx*0.5
        elif self.state == "strafe_right": self.move_x += ny*0.5;  self.move_y += -nx*0.5
        elif self.state == "retreat":      self.move_x -= nx*0.35; self.move_y -= ny*0.35
        self.move_x += randint(-10,10)/50; self.move_y += randint(-10,10)/50
        if self.dash_timer <= 0:
            self.move_x += nx*10; self.move_y += ny*10; self.dash_timer = randint(120,260)
        self.move_x *= 0.92; self.move_y *= 0.92
        spd = max((self.move_x**2+self.move_y**2)**0.5, 1)
        self.move_x = (self.move_x/spd)*min(spd,self.speed)
        self.move_y = (self.move_y/spd)*min(spd,self.speed)
        self.x += self.move_x; self.y += self.move_y
        if self.x < 0: self.x=0; self.move_x*=-0.5
        if self.x+self.width > WINDOW_WIDTH: self.x=WINDOW_WIDTH-self.width; self.move_x*=-0.5
        if self.y < 0: self.y=0; self.move_y*=-0.5
        if self.y+self.height > WINDOW_HEIGHT: self.y=WINDOW_HEIGHT-self.height; self.move_y*=-0.5
        self.rect = pygame.Rect(self.x, self.y, self.width, self.height)

    def draw(self, surface):
        pygame.draw.rect(surface, (200,50,50), self.rect)

    def draw_hitbox(self, surface):
        pygame.draw.rect(surface, (255,0,0), self.rect, 2)

class TankEnemy(Enemy):
    def __init__(self, x, y, room_level=0):
        super().__init__(x, y)
        self.hp = int(10 * (1 + room_level * 0.10))
        self.speed = 0.8  # wolny
        self.color = (120, 20, 20)
    def update(self, player):
        self.memory_timer += 1
        if self.memory_timer % FPS == 0:
            self.learn(player)
        style = get_player_style(player)
        if style == "melee":
            self.speed = 1.1
        elif style == "ranged":
            self.speed = 0.9
        dx = player.x - self.x
        dy = player.y - self.y
        dist = max(math.hypot(dx, dy), 1)
        self.x += (dx / dist) * self.speed
        self.y += (dy / dist) * self.speed
        self.rect = pygame.Rect(self.x, self.y, self.width, self.height)
    def draw(self, surface):
        pygame.draw.rect(surface, self.color, self.rect)

class RangedEnemy(Enemy):
    def __init__(self, x, y, room_level=0):
        super().__init__(x, y)
        self.hp = int(4 * (1 + room_level * 0.10))
        self.speed = 1.2
        self.shoot_timer = randint(40, 100)
        self.color = (80, 120, 255)
    def update(self, player, bullets):
        self.memory_timer += 1
        if self.memory_timer % FPS == 0:
            self.learn(player)
        style = get_player_style(player)
        if style == "ranged":
            self.shoot_timer -= 1
            self.speed = max(self.speed, 1.5)
        elif style == "melee":
            self.shoot_timer -= 0.5
            self.speed = max(self.speed, 1.35)
        elif style == "kiter":
            self.shoot_timer -= 1.5
            self.speed = max(self.speed, 1.65)
        dx = player.x - self.x
        dy = player.y - self.y
        dist = max(math.hypot(dx, dy), 1)
        nx, ny = dx / dist, dy / dist
        if dist < 250:
            self.x -= nx * self.speed
            self.y -= ny * self.speed
        elif dist > 350:
            self.x += nx * self.speed
            self.y += ny * self.speed
        self.shoot_timer -= 1
        if self.shoot_timer <= 0:
            self.shoot_timer = randint(110, 180)
            bullets.append(Bullet(self.x, self.y, (player.x, player.y), speed=6, owner="enemy"))
        self.rect = pygame.Rect(self.x, self.y, self.width, self.height)
    def draw(self, surface):
        pygame.draw.rect(surface, self.color, self.rect)

class BossEnemy(Enemy):
    def __init__(self, x, y):
        super().__init__(x, y)

        self.hp = 120
        self.max_hp = 120
        self.speed = 1.2
        self.phase = 1
        self.attack_timer = 60
        self.bullet_speed = 5
        self.attack_min = 40
        self.attack_max = 80
        self.spread = 0.25
        self.prediction = 18
        self.burst_count = 8
        self.dash_distance = 90

        try:
            self.image = pygame.image.load(img_path("Rabendix.png")).convert_alpha()
            self.image = pygame.transform.scale(self.image, (120, 120))
            self.image.fill((70, 90, 170, 255), special_flags=pygame.BLEND_RGBA_MULT)
        except:
            self.image = pygame.Surface((120, 120))
            self.image.fill((20, 45, 130))

        self.rect = pygame.Rect(self.x, self.y, 120, 120)
        self.learned = {
            "ranged": 0,
            "melee": 0,
            "kiter": 0,
            "balanced": 0
        }

        self.ai_timer = 0
        self.adapt_timer = 0

    def update(self, player):
        style = get_player_style(player)
        self.learned[style] += 1
        hp_ratio = self.hp / self.max_hp

        if hp_ratio < 0.6:
            self.phase = 2
        if hp_ratio < 0.3:
            self.phase = 3

        dx = player.x - self.x
        dy = player.y - self.y
        dist = max(math.hypot(dx, dy), 1)

        nx = dx / dist
        ny = dy / dist

        if self.phase == 1:
            self.x += nx * self.speed
            self.y += ny * self.speed

        elif self.phase == 2:
            self.x += nx * self.speed * 0.8
            self.y += ny * self.speed * 0.8
            self.x += math.sin(pygame.time.get_ticks() * 0.01) * 2

        elif self.phase == 3:
            self.x += nx * 2.2
            self.y += ny * 2.2

        self.attack_timer -= 1

        if self.attack_timer <= 0:
            self.attack_timer = randint(self.attack_min, self.attack_max)
            target = (
                player.x + player.width//2 + getattr(player, "vel_x", 0) * self.prediction,
                player.y + player.height//2 + getattr(player, "vel_y", 0) * self.prediction
            )

            attack = randint(1, 3)

            if attack == 1:
                for i in range(5):
                    aim_dx = target[0] - self.x
                    aim_dy = target[1] - self.y
                    angle = math.atan2(aim_dy, aim_dx) + (i - 2) * self.spread
                    bx = self.x + math.cos(angle) * 30
                    by = self.y + math.sin(angle) * 30
                    bullets.append(
                        Bullet(bx, by, target, speed=self.bullet_speed, owner="enemy")
                    )

            elif attack == 2:
                self.x += nx * self.dash_distance
                self.y += ny * self.dash_distance

            elif attack == 3:
                for i in range(self.burst_count):
                    bullets.append(
                        Bullet(
                            self.x,
                            self.y,
                            (
                                target[0] + randint(-120, 120),
                                target[1] + randint(-120, 120)
                            ),
                            speed=max(4, self.bullet_speed - 1),
                            owner="enemy"
                        )
                    )
        self.adapt_timer += 1
        if self.adapt_timer % 60 == 0:
            adapt_ai(self)
        self.rect = pygame.Rect(self.x, self.y, 120, 120)

    def draw(self, surface):
        surface.blit(self.image, (self.x, self.y))

class Slash:
    def __init__(self, player, mouse_pos):
        self.damage = player.slash_damage; self.range = player.slash_range
        self.duration = 12; self.hit_enemies = {}
        self.cx = player.x+player.width//2; self.cy = player.y+player.height//2
        mx, my = mouse_pos; dx = mx-self.cx; dy = my-self.cy
        length = max((dx**2+dy**2)**0.5, 1)
        self.dir_x = dx/length; self.dir_y = dy/length
        self.angle = math.degrees(math.atan2(-self.dir_y, self.dir_x))
        self.offset = 15
        self.frames = []; self.current_frame = 0
        self.frame_timer = 0; self.frame_speed = 4; self.use_images = True
        for i in range(1, 4):
            try:
                img = pygame.image.load(img_path(f".vscode/Images/Slash{i}.png")).convert_alpha()
                self.frames.append(pygame.transform.scale(img, (140,140)))
            except:
                self.use_images = False; break

    def update(self):
        self.duration -= 1
        for eid in list(self.hit_enemies):
            self.hit_enemies[eid] -= 1
            if self.hit_enemies[eid] <= 0: del self.hit_enemies[eid]
        if self.use_images and len(self.frames) > 1:
            self.frame_timer += 1
            if self.frame_timer >= self.frame_speed:
                self.frame_timer = 0
                if self.current_frame < len(self.frames)-1: self.current_frame += 1

    def hits_enemy(self, enemy):
        ecx = enemy.x+enemy.width/2; ecy = enemy.y+enemy.height/2
        sx = self.cx+self.dir_x*self.offset; sy = self.cy+self.dir_y*self.offset
        dx = ecx-sx; dy = ecy-sy
        if (dx**2+dy**2)**0.5 > self.range: return False
        ea = math.atan2(dy,dx); sa = math.atan2(self.dir_y,self.dir_x)
        arc = math.radians(70); diff = abs(ea-sa)
        if diff > math.pi: diff = 2*math.pi - diff
        return diff <= arc/2

    def draw(self, surface):
        sx = self.cx+self.dir_x*self.offset; sy = self.cy+self.dir_y*self.offset
        if self.use_images and self.frames:
            img = self.frames[self.current_frame]
            rot = pygame.transform.rotate(img, self.angle)
            rect = rot.get_rect(center=(sx,sy))
            surface.blit(rot, rect)
            glow = pygame.transform.scale(rot,(int(rot.get_width()*1.2),int(rot.get_height()*1.2)))
            glow.set_alpha(70)
            effect_surface.blit(glow,(rect.x-10,rect.y-10),special_flags=pygame.BLEND_RGBA_ADD)
        else:
            a = math.atan2(self.dir_y,self.dir_x); arc = math.radians(70)
            pts = [(sx,sy)]
            for i in range(21):
                ca = a-arc/2+(arc/20)*i
                pts.append((sx+math.cos(ca)*self.range, sy+math.sin(ca)*self.range))
            pygame.draw.polygon(surface,(255,255,255),pts)

class Bullet:
    def __init__(self, x, y, mouse_pos, speed=10, owner="player"):
        self.x=x; self.y=y; self.radius=6; self.speed=speed; self.damage=2; self.owner=owner
        mx,my=mouse_pos; dx=mx-x; dy=my-y
        length=max((dx**2+dy**2)**0.5,1)
        self.dir_x=dx/length; self.dir_y=dy/length; self.alive=True; self.hit_wall=False

    def update(self):
        self.x+=self.dir_x*self.speed; self.y+=self.dir_y*self.speed
        if self.x-self.radius<=0 or self.x+self.radius>=WINDOW_WIDTH or self.y-self.radius<=0 or self.y+self.radius>=WINDOW_HEIGHT:
            self.hit_wall=True; self.alive=False

    def get_rect(self):
        return pygame.Rect(self.x-self.radius,self.y-self.radius,self.radius*2,self.radius*2)

    def draw(self, surface):
        gs = get_glow_surface(self.radius,120)
        effect_surface.blit(gs,gs.get_rect(center=(int(self.x),int(self.y))),special_flags=pygame.BLEND_RGBA_ADD)
        color=(255,240,180) if self.owner=="player" else (255,150,150)
        pygame.draw.circle(surface,color,(int(self.x),int(self.y)),self.radius)

    def draw_hitbox(self, surface):
        pygame.draw.rect(surface,(0,255,255),self.get_rect(),1)

class Player:
    def __init__(self, x, y):
        self.stats = {
            "move_left": 0,
            "move_right": 0,
            "move_up": 0,
            "move_down": 0,
            "shoots": 0,
            "slashes": 0,
            "distance_sum": 0,
            "distance_samples": 0
        }
        self.kill_count = 0; self.heal_on_kill = False; self.frost = False
        self.heal_on_kill_amount = 1
        self.chaos = False; self.blood_pact = False
        self.greed = False; self.bullet_damage_penalty = False
        self.items = []; self.synergy_buffs = set()
        self.blood_pact = False; self.chaos = False; self.frost = False
        self.bullet_damage_penalty = False
        self.items = []; self.synergy_buffs = set()
        self.shoot_cooldown=0; self.max_ammo=6; self.ammo=self.max_ammo
        self.reloading=False; self.reload_timer=0; self.reload_duration=180
        self.attack_cooldown=0; self.max_hp=6; self.hp=self.max_hp
        self.safe_timer=0; self.invincibility_frames=60
        self.x=x; self.y=y; self.speed=3
        self.prev_x=x; self.prev_y=y; self.vel_x=0; self.vel_y=0
        self.bullet_speed=10
        self.extra_shot=False          # ← Extra Shot powerup flag
        self.slash_range=90; self.slash_damage=1
        try:
            img = pygame.image.load(img_path(".vscode/Images/postac.png")).convert_alpha()
            self.image = pygame.transform.scale(img,(48,64))
        except:
            self.image = pygame.Surface((48,64)); self.image.fill((255,0,0))
        self.width=self.image.get_width(); self.height=self.image.get_height()
        self.hitbox=pygame.Rect(self.x,self.y,self.width,self.height)

    def handle_input(self, keys):
        if keys[pygame.K_a]: 
            self.stats["move_left"] += 1
        if keys[pygame.K_d]: 
            self.stats["move_right"] += 1
        if keys[pygame.K_w]: 
            self.stats["move_up"] += 1
        if keys[pygame.K_s]: 
            self.stats["move_down"] += 1
        if keys[pygame.K_w]: self.y-=self.speed
        if keys[pygame.K_s]: self.y+=self.speed
        if keys[pygame.K_a]: self.x-=self.speed
        if keys[pygame.K_d]: self.x+=self.speed
        self.x=max(0,min(self.x,WINDOW_WIDTH-self.width))
        self.y=max(0,min(self.y,WINDOW_HEIGHT-self.height))

    def update(self):
        self.vel_x=self.x-self.prev_x
        self.vel_y=self.y-self.prev_y
        self.prev_x=self.x
        self.prev_y=self.y
        self.hitbox=pygame.Rect(self.x,self.y,self.width,self.height)
        if self.safe_timer>0: self.safe_timer-=1
        if self.attack_cooldown>0: self.attack_cooldown-=1
        if self.shoot_cooldown>0: self.shoot_cooldown-=1
        if self.reloading:
            self.reload_timer-=1
            if self.reload_timer<=0:
                self.reloading=False; self.ammo=self.max_ammo
        if self.chaos and randint(1, 200) == 1:
            self.speed = max(2, self.speed + choice([-1, 1, 2, -2]))

    def draw(self, surface):
        if self.safe_timer>0 and (self.safe_timer//5)%2==0: return
        surface.blit(self.image,(self.x,self.y))

    def draw_hitbox(self, surface):
        pygame.draw.rect(surface,(0,255,0),self.hitbox,2)

    def add_item(self, item_name):
        self.items.append(item_name)
        self.recalculate_synergies()

    def restore_items(self, items):
        self.items = []
        self.synergy_buffs = set()
        for item_name in items:
            powerup = get_powerup_def(item_name)
            if powerup:
                PowerupItem(0, 0, powerup).apply(self)

    def recalculate_synergies(self):
        changed = True
        while changed:
            changed = False
            names = set(self.items) | set(self.synergy_buffs)

            for combo, data in SYNERGIES.items():
                triggered = False

                if len(combo) == 2:
                    if combo[0] in names and combo[1] in names:
                        triggered = True
                        
                elif len(combo) == 3:
                    if all(c in names for c in combo):
                        triggered = True
                if triggered and data["name"] not in self.synergy_buffs:
                    data["apply"](self)
                    self.synergy_buffs.add(data["name"])
                    changed = True

def get_player_style(player):
    if player.stats["distance_samples"] == 0:
        return "neutral"

    avg_dist = player.stats["distance_sum"] / player.stats["distance_samples"]
    horizontal = player.stats["move_left"] + player.stats["move_right"]
    vertical = player.stats["move_up"] + player.stats["move_down"]
    movement_total = horizontal + vertical

    if player.stats["shoots"] > player.stats["slashes"] * 2:
        return "ranged"

    if player.stats["slashes"] > player.stats["shoots"] * 2:
        return "melee"

    if avg_dist > 300 or movement_total > (player.stats["shoots"] + player.stats["slashes"] + 1) * 8:
        return "kiter"

    if horizontal > vertical * 2 and movement_total > 120:
        return "kiter"

    return "balanced"

def load_backgrounds():
    bgs=[]
    for i in range(4):
        try:
            bg=pygame.image.load(img_path(f".vscode/Images/tlo{i}.png"))
            bgs.append(pygame.transform.scale(bg,(WINDOW_WIDTH,WINDOW_HEIGHT)))
        except: pass
    if not bgs:
        bg=pygame.Surface((WINDOW_WIDTH,WINDOW_HEIGHT)); bg.fill((0,0,0)); bgs.append(bg)
    return bgs

def player_touching_exit(player):
    cx = player.x + player.width // 2
    cy = player.y + player.height // 2
    door_size = 200
    half_door = door_size // 2
    center_x = WINDOW_WIDTH // 2
    center_y = WINDOW_HEIGHT // 2
    if center_x - half_door <= cx <= center_x + half_door:
        if cy <= 48:
            return "top"
        if cy >= WINDOW_HEIGHT - 48:
            return "bottom"
    if center_y - half_door <= cy <= center_y + half_door:
        if cx <= 48:
            return "left"
        if cx >= WINDOW_WIDTH - 48:
            return "right"
    return None

def spawn_enemies(count, player, room_level=0):
    enemies = []
    for _ in range(count):
        while True:
            x = randint(50, WINDOW_WIDTH - 50)
            y = randint(50, WINDOW_HEIGHT - 50)
            if ((x - player.x) ** 2 + (y - player.y) ** 2) ** 0.5 > 250:
                roll = randint(1, 100)
                if roll < 20:
                    e = TankEnemy(x, y, room_level)
                elif roll < 45:
                    e = RangedEnemy(x, y, room_level)
                else:
                    e = Enemy(x, y)
                enemies.append(e)
                break
    return enemies

BOSS_CHANCE = 10
BOSS_ROOM_BG = "bossroom0.png"

def should_spawn_boss():
    return randint(1, 100) <= BOSS_CHANCE

def on_enemy_killed(player):
    player.kill_count += 1
    play_sound("explode")

    if player.heal_on_kill or player.blood_pact:
        player.hp = min(player.max_hp, player.hp + max(1, player.heal_on_kill_amount))

    if player.chaos:
        if randint(1, 100) < 20:
            player.hp = max(1, player.hp - 1)

def spawn_powerup_items():
    chosen = sample(POWERUP_DEFS, 2)
    cx=WINDOW_WIDTH//2; cy=WINDOW_HEIGHT//2
    return [PowerupItem(cx-100, cy, chosen[0]), PowerupItem(cx+100, cy, chosen[1])]

def get_next_room_position(rx,ry,side):
    return {"top":(rx,ry-1),"bottom":(rx,ry+1),"left":(rx-1,ry),"right":(rx+1,ry)}.get(side,(rx,ry))

def teleport_player(player, side):
    margin=32
    if side=="top":     player.y=WINDOW_HEIGHT-player.height-margin-5
    elif side=="bottom":player.y=margin+5
    elif side=="left":  player.x=WINDOW_WIDTH-player.width-margin-5
    elif side=="right": player.x=margin+5

def boss_spawn_position(entry_side):
    margin = 120
    if entry_side == "top":
        return WINDOW_WIDTH//2, margin
    if entry_side == "bottom":
        return WINDOW_WIDTH//2, WINDOW_HEIGHT-margin
    if entry_side == "left":
        return margin, WINDOW_HEIGHT//2
    if entry_side == "right":
        return WINDOW_WIDTH-margin, WINDOW_HEIGHT//2
    return WINDOW_WIDTH//2, WINDOW_HEIGHT//2

def draw_minimap(surface, rooms, current_room):
    ms=scaled(100); margin=scaled(5); vr=2
    mx=WINDOW_WIDTH-ms-margin; my=margin
    rs=ms//(vr*2+1); cx,cy=current_room
    border=scaled(2)
    pygame.draw.rect(surface,(20,20,20),(mx-border,my-border,ms+border*2,ms+border*2))
    for pos,data in rooms.items():
        rx,ry=pos; relx=rx-cx; rely=ry-cy
        if abs(relx)>vr or abs(rely)>vr: continue
        dx=mx+(relx+vr)*rs; dy=my+(rely+vr)*rs
        rect=pygame.Rect(dx,dy,rs,rs)
        if pos==current_room: col=(255,255,255)
        elif data["power"]: col=(255,105,180)
        elif data["cleared"]: col=(120,120,120)
        else: col=(80,80,80)
        pygame.draw.rect(surface,col,rect)
        pygame.draw.rect(surface,(30,30,30),rect,max(1,scaled(1)))

def draw_hud(surface, player, font):
    font=get_font(max(18, scaled(30)))
    small_font=get_font(max(14, scaled(22)))
    x=scaled(20)
    y=scaled(20)
    surface.blit(font.render(f"HP: {player.hp}/{player.max_hp}",True,(255,80,80)),(x,y))
    if player.reloading:
        pct=1.0-(player.reload_timer/player.reload_duration)
        bar_x=x
        bar_y=y+scaled(38)
        bar_w=scaled(120)
        bar_h=scaled(12)
        pygame.draw.rect(surface,(60,60,60),(bar_x,bar_y,bar_w,bar_h))
        pygame.draw.rect(surface,(255,200,50),(bar_x,bar_y,int(bar_w*pct),bar_h))
        surface.blit(font.render("RELOADING",True,(255,200,50)),(x,y+scaled(52)))
    else:
        surface.blit(font.render(f"AMMO: {player.ammo}/{player.max_ammo}",True,(220,220,100)),(x,y+scaled(35)))
    synergy_y=y+scaled(80)
    for s in player.synergy_buffs:
        surface.blit(small_font.render(f"SYNERGY: {s}",True,(120,255,200)),(x,synergy_y))
        synergy_y += scaled(24)

def draw_pause_overlay(surface):
    overlay = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.SRCALPHA)
    overlay.fill((0,0,0,140))
    surface.blit(overlay,(0,0))

    pf = pygame.font.SysFont("comicsansms",90,bold=True)
    sf = pygame.font.SysFont("comicsansms",34)

    pt = pf.render(tr("PAUSED"), True, (255,255,255))
    surface.blit(pt,(WINDOW_WIDTH//2-pt.get_width()//2,WINDOW_HEIGHT//2-120))

    for i, (line, col) in enumerate([
        (tr("RESUME"), (200,200,200)),
        (tr("SAVE_GAME"), (180,230,180)),
        (tr("QUIT_MENU"), (200,200,200))
    ]):
        t = sf.render(line, True, col)
        surface.blit(t,(WINDOW_WIDTH//2-t.get_width()//2,WINDOW_HEIGHT//2+10+i*50))

def draw_inventory(surface, player, font):
    mouse = pygame.mouse.get_pos()
    overlay = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT), pygame.SRCALPHA)
    overlay.fill((0,0,0,210))

    title_font = get_font(scaled(46), True)
    item_font = get_font(scaled(25), True)
    small_font = get_font(scaled(20))
    title = title_font.render(tr("INVENTORY"), True, (255,255,255))
    overlay.blit(title, (WINDOW_WIDTH//2 - title.get_width()//2, scaled(35)))

    hint = small_font.render(tr("TAB_HINT"), True, (180,180,190))
    overlay.blit(hint, (WINDOW_WIDTH//2 - hint.get_width()//2, scaled(88)))

    left = scaled(120)
    top = scaled(135)
    row_h = scaled(42)
    col_w = (WINDOW_WIDTH - scaled(300)) // 2
    hovered_title = None
    hovered_desc = None

    header = item_font.render(tr("POWERUPS"), True, (200,255,220))
    overlay.blit(header, (left, top - scaled(38)))
    for i,item in enumerate(player.items):
        rect = pygame.Rect(left, top + i*row_h, col_w, row_h - scaled(6))
        hovered = rect.collidepoint(mouse)
        pygame.draw.rect(overlay, (45,65,60,230) if hovered else (25,35,35,190), rect, border_radius=scaled(6))
        pygame.draw.rect(overlay, (120,220,180), rect, max(1, scaled(1)), border_radius=scaled(6))
        name, fallback_desc = tr_item(item)
        txt=item_font.render(name,True,(230,255,235))
        overlay.blit(txt, (rect.x+scaled(12), rect.y+scaled(7)))
        if hovered:
            item_def = get_powerup_def(item)
            hovered_title = name
            hovered_desc = item_def["desc"] if item_def else fallback_desc

    right = left + col_w + scaled(60)
    header = item_font.render(tr("SYNERGIES"), True, (255,220,140))
    overlay.blit(header, (right, top - scaled(38)))
    for i,s in enumerate(sorted(player.synergy_buffs)):
        rect = pygame.Rect(right, top + i*row_h, col_w, row_h - scaled(6))
        hovered = rect.collidepoint(mouse)
        pygame.draw.rect(overlay, (80,55,25,230) if hovered else (45,35,20,190), rect, border_radius=scaled(6))
        pygame.draw.rect(overlay, (255,200,120), rect, max(1, scaled(1)), border_radius=scaled(6))
        txt=item_font.render(s,True,(255,230,160))
        overlay.blit(txt, (rect.x+scaled(12), rect.y+scaled(7)))
        if hovered:
            hovered_title = s
            hovered_desc = get_synergy_desc(s)

    if hovered_title:
        panel = pygame.Rect(scaled(160), WINDOW_HEIGHT-scaled(175), WINDOW_WIDTH-scaled(320), scaled(125))
        pygame.draw.rect(overlay, (15,18,24,245), panel, border_radius=scaled(8))
        pygame.draw.rect(overlay, (160,190,220), panel, scaled(2), border_radius=scaled(8))
        title_surf = item_font.render(hovered_title, True, (255,255,255))
        overlay.blit(title_surf, (panel.x+scaled(18), panel.y+scaled(14)))
        for i,line in enumerate(wrap_text(hovered_desc, small_font, panel.width-scaled(36))[:3]):
            line_surf = small_font.render(line, True, (210,220,230))
            overlay.blit(line_surf, (panel.x+scaled(18), panel.y+scaled(55)+i*scaled(24)))

    surface.blit(overlay, (0,0))

def save_settings():
    with open(SETTINGS_FILE,"w") as f: json.dump(settings,f)

def has_save():
    return os.path.exists(SAVE_FILE)

def delete_save():
    try:
        if os.path.exists(SAVE_FILE):
            os.remove(SAVE_FILE)
    except:
        pass

def save_game(player, room_x, room_y, num_of_lvl):
    data = {
        "room_x": room_x,
        "room_y": room_y,
        "num_of_lvl": num_of_lvl,
        "player": {
            "items": player.items,
            "hp": player.hp,
            "ammo": player.ammo,
            "stats": player.stats
        }
    }
    try:
        with open(SAVE_FILE, "w") as f:
            json.dump(data, f)
        return True
    except:
        return False

def load_game():
    try:
        with open(SAVE_FILE, "r") as f:
            return json.load(f)
    except:
        return None

def load_settings():
    global settings
    try:
        with open(SETTINGS_FILE,"r") as f: settings.update(json.load(f))
        if settings.pop("fullscreen", False):
            settings["window_scale"] = "fullscreen"
    except: save_settings()

def apply_settings():
    global window,WINDOW_WIDTH,WINDOW_HEIGHT,effect_surface
    if settings["window_scale"] == "fullscreen":
        make_fullscreen()
    else:
        scale=settings["window_scale"]
        WINDOW_WIDTH=int(BASE_WINDOW_WIDTH*scale); WINDOW_HEIGHT=int(BASE_WINDOW_HEIGHT*scale)
        window=pygame.display.set_mode((WINDOW_WIDTH,WINDOW_HEIGHT))
        center_window()
    effect_surface=pygame.Surface((WINDOW_WIDTH,WINDOW_HEIGHT),pygame.SRCALPHA)

def apply_audio_settings():
    start_background_music()
    if pygame.mixer.get_init(): pygame.mixer.music.set_volume(settings["music_volume"])
    update_sfx_volume()

load_settings(); apply_settings(); apply_audio_settings()

FONT_PATH=os.path.join(BASE_DIR,"NotoSansJP-Regular.ttf")

def get_font(size,bold=False):
    if settings["language"]=="Japanese":
        try:
            return pygame.font.Font(FONT_PATH,size)
        except:
            return pygame.font.SysFont("meiryo",size)
    return pygame.font.SysFont("comicsansms",size,bold=bold)

def draw_text(surface, text, x, y, size=30, color=(255,255,255), bold=False):
    font = get_font(size, bold)
    surf = font.render(text, True, color)
    surface.blit(surf, (x, y))
    return surf.get_rect(topleft=(x, y))

def draw_settings_controls(surface):
    title_font = get_font(scaled(30), True)
    text_font = get_font(scaled(20))
    panel_x = scaled(820)
    panel_y = scaled(145)
    panel_w = max(scaled(360), WINDOW_WIDTH - panel_x - scaled(70))
    line_h = scaled(27)

    controls = list(BASE_CONTROL_KEYS)
    dev_enabled = settings.get("dev_keys_enabled", False)

    title = title_font.render(tr("CONTROLS"), True, (255,255,255))
    surface.blit(title, (panel_x, panel_y))
    y = panel_y + scaled(42)
    for key in controls:
        line = text_font.render(tr(key), True, (210,220,230))
        surface.blit(line, (panel_x, y))
        y += line_h

    y += scaled(18)
    dev_title = title_font.render(f"{tr('DEV_TOOLS')}: {tr('ON') if dev_enabled else tr('OFF')}", True, (127,255,212) if dev_enabled else (220,160,160))
    surface.blit(dev_title, (panel_x, y))
    y += scaled(42)

    if dev_enabled:
        for key in DEV_CONTROL_KEYS:
            line = text_font.render(tr(key), True, (255,220,160))
            surface.blit(line, (panel_x, y))
            y += line_h
    else:
        line = text_font.render(tr("DEV_KEYS"), True, (150,150,160))
        surface.blit(line, (panel_x, y))

def settings_menu():
    langs=["English","Polski","Japanese"]
    resolutions=[0.75,1.0,1.25,1.5,"fullscreen"]
    options=[
        {"type":"dropdown","name":"LANGUAGE","key":"language","values":langs},
        {"type":"slider","name":"GAMMA","key":"gamma","min":0.5,"max":1.5},
        {"type":"dropdown","name":"WINDOW_SIZE","key":"window_scale","values":resolutions},
        {"type":"slider","name":"MUSIC_VOLUME","key":"music_volume","min":0.0,"max":1.0},
        {"type":"slider","name":"SFX_VOLUME","key":"sfx_volume","min":0.0,"max":1.0},
        {"type":"toggle","name":"DEV_KEYS","key":"dev_keys_enabled"},
        {"type":"button","name":"BACK"}
    ]
    selected=0
    dragging_slider=None

    def option_rect(index):
        option_w=scaled(560)
        option_h=scaled(60)
        option_x=scaled(80)
        option_y=scaled(145)+index*scaled(70)
        return pygame.Rect(option_x,option_y,option_w,option_h)

    while True:
        font=get_font(scaled(34))
        sfont=get_font(scaled(24))
        tfont=get_font(scaled(72))
        clock.tick(FPS)
        mouse=pygame.mouse.get_pos()
        for ev in pygame.event.get():
            if ev.type==pygame.QUIT:
                pygame.quit()
                sys.exit()
            if ev.type==pygame.KEYDOWN:
                if ev.key==pygame.K_UP:selected=(selected-1)%len(options)
                if ev.key==pygame.K_DOWN:selected=(selected+1)%len(options)
                current=options[selected]
                if current["type"]=="dropdown":
                    vals=current["values"]
                    idx=vals.index(settings[current["key"]])
                    if ev.key==pygame.K_LEFT:idx=(idx-1)%len(vals)
                    if ev.key==pygame.K_RIGHT:idx=(idx+1)%len(vals)
                    settings[current["key"]]=vals[idx]
                    if current["key"]=="window_scale":
                        apply_settings()
                elif current["type"]=="slider":
                    if ev.key==pygame.K_LEFT:
                        settings[current["key"]]-=0.1
                    if ev.key==pygame.K_RIGHT:
                        settings[current["key"]]+=0.1
                    settings[current["key"]]=round(settings[current["key"]],1)
                    settings[current["key"]]=max(current["min"],min(current["max"],settings[current["key"]]))
                    if current["key"]=="window_scale":
                        apply_settings()
                    if current["key"] in ["music_volume","sfx_volume"]:
                        apply_audio_settings()
                elif current["type"]=="toggle":
                    if ev.key in (pygame.K_LEFT,pygame.K_RIGHT,pygame.K_RETURN):
                        settings[current["key"]]=not settings.get(current["key"], False)
                elif current["type"]=="button":
                    if ev.key==pygame.K_RETURN:
                        save_settings()
                        return
            if ev.type==pygame.MOUSEBUTTONDOWN and ev.button==1:
                for i,option in enumerate(options):
                    rect=option_rect(i)
                    if rect.collidepoint(mouse):
                        selected=i
                        if option["type"]=="dropdown":
                            vals=option["values"]
                            idx=vals.index(settings[option["key"]])
                            idx=(idx+1)%len(vals)
                            settings[option["key"]]=vals[idx]
                            if option["key"]=="window_scale":
                                apply_settings()
                        elif option["type"]=="slider":
                            dragging_slider=option
                        elif option["type"]=="toggle":
                            settings[option["key"]]=not settings.get(option["key"], False)
                        elif option["type"]=="button":
                            save_settings()
                            return
            if ev.type==pygame.MOUSEBUTTONUP and ev.button==1:
                dragging_slider=None
            if ev.type==pygame.MOUSEMOTION and dragging_slider:
                slider_x=option_rect(selected).x+scaled(265)
                slider_w=scaled(220)
                mx=mouse[0]
                percent=(mx-slider_x)/slider_w
                percent=max(0,min(1,percent))
                minv=dragging_slider["min"]
                maxv=dragging_slider["max"]
                value=minv+(maxv-minv)*percent
                value=round(value,2)
                settings[dragging_slider["key"]]=value
                if dragging_slider["key"]=="window_scale":
                    apply_settings()
                if dragging_slider["key"] in ["music_volume","sfx_volume"]:
                    apply_audio_settings()
        window.fill((15,15,15))
        title=tfont.render(tr("SETTINGS"),True,(255,255,255))
        window.blit(title,(WINDOW_WIDTH//2-title.get_width()//2,scaled(50)))
        for i,option in enumerate(options):
            rect=option_rect(i)
            hovered=rect.collidepoint(mouse)
            bg=(40,40,40)
            if hovered:bg=(55,55,55)
            if i==selected:bg=(70,70,90)
            pygame.draw.rect(window,bg,rect,border_radius=scaled(12))
            pygame.draw.rect(window,(120,120,140),rect,scaled(2),border_radius=scaled(12))
            label=font.render(tr(option["name"]),True,(255,255,255))
            window.blit(label,(rect.x+scaled(20),rect.y+scaled(12)))
            if option["type"]=="dropdown":
                raw_value=settings[option["key"]]
                value=tr("FULLSCREEN") if raw_value=="fullscreen" else tr(str(raw_value))
                value_text=font.render(value,True,(127,255,212))
                window.blit(value_text,(rect.right-value_text.get_width()-scaled(20),rect.y+scaled(12)))
                arrows=sfont.render("<   >",True,(200,200,200))
                window.blit(arrows,(rect.right-value_text.get_width()-scaled(90),rect.y+scaled(18)))
            elif option["type"]=="slider":
                slider_x=rect.x+scaled(265)
                slider_y=rect.y+rect.height//2
                slider_w=scaled(220)
                pygame.draw.line(window,(100,100,100),(slider_x,slider_y),(slider_x+slider_w,slider_y),scaled(6))
                minv=option["min"]
                maxv=option["max"]
                val=settings[option["key"]]
                percent=(val-minv)/(maxv-minv)
                knob_x=slider_x+int(percent*slider_w)
                pygame.draw.circle(window,(127,255,212),(knob_x,slider_y),scaled(12))
                if option["key"] in ["music_volume","sfx_volume"]:
                    txt=f"{int(val*100)}%"
                else:
                    txt=str(round(val,1))
                value_text=sfont.render(txt,True,(255,255,255))
                window.blit(value_text,(slider_x+slider_w+scaled(20),slider_y-scaled(12)))
            elif option["type"]=="toggle":
                enabled=settings.get(option["key"], False)
                value_text=font.render(tr("ON") if enabled else tr("OFF"),True,(127,255,212) if enabled else (220,160,160))
                window.blit(value_text,(rect.right-value_text.get_width()-scaled(20),rect.y+scaled(12)))
            elif option["type"]=="button":
                txt=font.render("ENTER",True,(255,200,120))
                window.blit(txt,(rect.right-txt.get_width()-scaled(20),rect.y+scaled(12)))
        draw_settings_controls(window)
        pygame.display.update()

def main_menu():
    AQUA=(127,255,212); AQUA_H=(170,255,230); OUT=(0,0,0); TXT=(0,0,0)
    def draw_btn(rect,text,hover=False):
        col=AQUA_H if hover else AQUA
        x,y,w,h=rect.x,rect.y,rect.width,rect.height
        slant=scaled(35)
        pts=[(x+slant,y),(x+w-slant,y),(x+w,y+h//2),(x+w-slant,y+h),(x+slant,y+h),(x,y+h//2)]
        pygame.draw.polygon(window,col,pts); pygame.draw.polygon(window,OUT,pts,scaled(8))
        lbl=bfont.render(text,True,TXT)
        window.blit(lbl,(rect.centerx-lbl.get_width()//2,rect.centery-lbl.get_height()//2))
    while True:
        tfont=get_font(scaled(110),True)
        bfont=get_font(scaled(42),True)
        button_w=scaled(340)
        button_h=scaled(90)
        left_x=scaled(60)
        offset_x=scaled(50)
        play_r=pygame.Rect(left_x,scaled(300),button_w,button_h)
        sett_r=pygame.Rect(left_x+offset_x,scaled(430),button_w,button_h)
        quit_r=pygame.Rect(left_x,scaled(560),button_w,button_h)
        save_exists=has_save()
        reset_r=pygame.Rect(play_r.right+scaled(18),play_r.y+scaled(18),scaled(125),scaled(54))
        clock.tick(FPS); mp=pygame.mouse.get_pos()
        for ev in pygame.event.get():
            if ev.type==pygame.QUIT: pygame.quit(); sys.exit()
            if ev.type==pygame.KEYDOWN and ev.key==pygame.K_ESCAPE: pygame.quit(); sys.exit()
            if ev.type==pygame.MOUSEBUTTONDOWN and ev.button==1:
                if play_r.collidepoint(mp): return "continue" if save_exists else "new"
                if save_exists and reset_r.collidepoint(mp): delete_save()
                if sett_r.collidepoint(mp): settings_menu()
                if quit_r.collidepoint(mp): pygame.quit(); sys.exit()
        window.fill((12,12,12))
        t=tfont.render("Indiaan Jones",True,(255,255,255))
        window.blit(t,(WINDOW_WIDTH//2-t.get_width()//2,scaled(70)))
        draw_btn(play_r, tr("CONTINUE") if save_exists else tr("START"), play_r.collidepoint(mp))
        if save_exists:
            pygame.draw.rect(window,(170,35,35),reset_r,border_radius=scaled(8))
            pygame.draw.rect(window,(40,0,0),reset_r,scaled(3),border_radius=scaled(8))
            reset_txt=get_font(scaled(24),True).render(tr("RESET"),True,(255,240,240))
            window.blit(reset_txt,(reset_r.centerx-reset_txt.get_width()//2,reset_r.centery-reset_txt.get_height()//2))
        draw_btn(sett_r, tr("SETTINGS"), sett_r.collidepoint(mp))
        draw_btn(quit_r, tr("QUIT"), quit_r.collidepoint(mp))
        pygame.display.update()

def adapt_ai(self):
    dominant = max(self.learned, key=self.learned.get)

    if dominant == "ranged":
        self.speed = min(3.0, self.speed + 0.25)
        self.attack_min = max(20, self.attack_min - 4)
        self.attack_max = max(40, self.attack_max - 5)
        self.bullet_speed = min(8, self.bullet_speed + 0.35)
        self.spread = max(0.12, self.spread - 0.02)
        self.prediction = min(32, self.prediction + 2)

    elif dominant == "melee":
        self.speed = max(0.8, self.speed - 0.1)
        self.hp += 5  # tankowanie
        self.dash_distance = min(150, self.dash_distance + 8)
        self.attack_min = max(24, self.attack_min - 2)
        self.burst_count = min(12, self.burst_count + 1)

    elif dominant == "kiter":
        self.speed = min(3.4, self.speed + 0.35)
        self.phase = 2  # bardziej agresywny chase
        self.dash_distance = min(170, self.dash_distance + 10)
        self.prediction = min(36, self.prediction + 3)
        self.attack_max = max(38, self.attack_max - 4)

    elif dominant == "balanced":
        self.speed = min(2.8, self.speed * 1.04)
        self.bullet_speed = min(7, self.bullet_speed + 0.2)
        self.attack_min = max(25, self.attack_min - 2)

def main(load_saved=False):
    global effect_surface, show_inventory, room_intro_active, room_intro_timer, room_intro_text, room_intro_boss, room_intro_last_char
    show_inventory = False
    save_data = load_game() if load_saved else None
    player=Player(WINDOW_WIDTH//2-24,WINDOW_HEIGHT//2-32)
    bgs=load_backgrounds()
    try:
        power_bg=pygame.image.load(img_path(".vscode/Images/powerroom.png"))
        power_bg=pygame.transform.scale(power_bg,(WINDOW_WIDTH,WINDOW_HEIGHT))
    except:
        power_bg=pygame.Surface((WINDOW_WIDTH,WINDOW_HEIGHT)); power_bg.fill((60,40,90))

    cur_bg=choice(bgs); enemies=[]; slashes=[]; bullets=[]; powerup_items=[]
    num_of_lvl=0; room_x=0; room_y=0; room_enemy_progress = 0
    if save_data:
        room_x=save_data.get("room_x",0)
        room_y=save_data.get("room_y",0)
        num_of_lvl=save_data.get("num_of_lvl",0)
        pdata=save_data.get("player",{})
        player.restore_items(pdata.get("items",[]))
        player.hp=min(player.max_hp,pdata.get("hp",player.hp))
        player.ammo=min(player.max_ammo,pdata.get("ammo",player.ammo))
        player.stats.update(pdata.get("stats",{}))
    rooms={(0,0):{"cleared":True,"power":False,"background":cur_bg,"enemies":[],"powerups":[]}}
    if (room_x,room_y)!=(0,0):
        rooms[(room_x,room_y)]={"cleared":True,"power":False,"background":cur_bg,"enemies":[],"powerups":[]}
    paused=False; show_hitboxes=False; shift_held=False; entry_side=None; forced_next_room=None

    while True:
        font=get_font(30)
        fname=get_font(22,True)
        fdesc=get_font(18)
        clock.tick(FPS)
        e_pressed=False
        if room_intro_active:
            for ev in pygame.event.get():
                if ev.type==pygame.QUIT:
                    pygame.quit(); sys.exit()
                if ev.type==pygame.KEYDOWN:
                    if ev.key==pygame.K_ESCAPE:
                        paused=not paused
                    if ev.key==pygame.K_SPACE and room_intro_last_char>=len(room_intro_text):
                        room_intro_active = False
            draw_room_intro(window)
            pygame.display.update()
            continue
        for ev in pygame.event.get():
            if ev.type==pygame.QUIT: pygame.quit(); sys.exit()
            if ev.type==pygame.KEYDOWN:
                if ev.key in (pygame.K_LSHIFT,pygame.K_RSHIFT): shift_held=True
                if ev.type == pygame.KEYDOWN:
                        if ev.key == pygame.K_TAB:
                            show_inventory = not show_inventory
                if show_inventory and ev.key not in (pygame.K_TAB,):
                    continue
                if ev.key==pygame.K_ESCAPE: paused=not paused
                if paused and ev.key==pygame.K_s:
                    save_game(player, room_x, room_y, num_of_lvl)
                if ev.key==pygame.K_F2 and shift_held: show_hitboxes=not show_hitboxes
                if settings.get("dev_keys_enabled", False):
                    if ev.key==pygame.K_F6 and shift_held: forced_next_room="boss"
                    if ev.key==pygame.K_F7 and shift_held: forced_next_room="power"
                    if ev.key in (pygame.K_LCTRL, pygame.K_RCTRL) and enemies:
                        enemies.pop()
                if ev.key==pygame.K_e: e_pressed=True
                if paused and ev.key==pygame.K_q: return
            if ev.type==pygame.KEYUP:
                if ev.key in (pygame.K_LSHIFT,pygame.K_RSHIFT): shift_held=False
            if not paused and not show_inventory:
                if ev.type==pygame.MOUSEBUTTONDOWN:
                    if ev.button==1:
                        if len(slashes)==0 and player.attack_cooldown<=0:
                            slashes.append(Slash(player,pygame.mouse.get_pos()))
                            player.stats["slashes"] += 1
                            player.attack_cooldown=18
                    if ev.button==3:
                        if player.shoot_cooldown<=0 and not player.reloading and player.ammo>0:
                            mp=pygame.mouse.get_pos()
                            cx=player.x+player.width//2; cy=player.y+player.height//2
                            # main bullet
                            bullets.append(Bullet(cx,cy,mp,player.bullet_speed, owner="player"))
                            player.stats["shoots"] += 1
                            play_sound("shoot")
                            # extra shot: second bullet at +12° offset, costs 1 extra ammo
                            if player.extra_shot and player.ammo>1:
                                dx=mp[0]-cx; dy=mp[1]-cy
                                ang=math.atan2(dy,dx)+math.radians(12)
                                op=(cx+math.cos(ang)*200, cy+math.sin(ang)*200)
                                bullets.append(Bullet(cx,cy,op,player.bullet_speed, owner="player"))
                                player.ammo-=1
                            player.ammo-=1; player.shoot_cooldown=54
                            if player.ammo<=0:
                                player.reloading=True; player.reload_timer=player.reload_duration
                    

        if paused:
            draw_pause_overlay(window); pygame.display.update(); continue

        if show_inventory:
            window.blit(cur_bg,(0,0))
            for enemy in enemies: enemy.draw(window)
            for item in powerup_items: item.draw(window,fname,fdesc)
            for slash in slashes: slash.draw(window)
            for bullet in bullets: bullet.draw(window)
            player.draw(window)
            draw_hud(window,player,font)
            draw_minimap(window,rooms,(room_x,room_y))
            draw_inventory(window, player, font)
            pygame.display.update()
            continue

        keys=pygame.key.get_pressed()
        player.handle_input(keys)
        if keys[pygame.K_r] and not player.reloading and player.ammo<player.max_ammo:
            player.reloading=True; player.reload_timer=player.reload_duration

        rooms[(room_x,room_y)]["enemies"]=enemies
        if not enemies: rooms[(room_x,room_y)]["cleared"]=True

        player.update()

        for enemy in enemies:
            dist = math.hypot(player.x - enemy.x, player.y - enemy.y)
            player.stats["distance_sum"] += dist
            player.stats["distance_samples"] += 1

        for slash in slashes[:]:
            slash.update()
            for enemy in enemies[:]:
                if slash.hits_enemy(enemy) and id(enemy) not in slash.hit_enemies:
                    slash.hit_enemies[id(enemy)]=10; enemy.hp-=slash.damage
                    play_sound("hit")
                    if enemy.hp <= 0:
                        on_enemy_killed(player)
                        room_enemy_progress += 1
                        if player.greed and randint(1, 100) < 20:
                            player.ammo = min(player.max_ammo, player.ammo + 1) 
                        enemies.remove(enemy)
    

            if slash.duration<=0: slashes.remove(slash)

        for bullet in bullets[:]:
            bullet.update()
            if bullet.hit_wall:
                play_sound("explode")
                bullets.remove(bullet)
                continue
            if bullet.owner=="player":
                for enemy in enemies[:]:
                    if bullet.get_rect().colliderect(enemy.rect):
                        dmg = bullet.damage if hasattr(bullet, "damage") else 1
                        if player.bullet_damage_penalty:
                            dmg -= 1
                        enemy.hp -= max(1, dmg)
                        play_sound("hit")
                        bullet.alive = False
                        if enemy.hp <= 0:
                            on_enemy_killed(player)
                            enemies.remove(enemy)
                        break
            elif bullet.get_rect().colliderect(player.hitbox) and player.safe_timer<=0:
                player.hp-=1
                player.safe_timer=player.invincibility_frames
                play_sound("hit")
                bullet.alive=False
            if not bullet.alive:
                bullets.remove(bullet)

        for enemy in enemies:
            if isinstance(enemy, RangedEnemy):
                enemy.update(player, bullets)
            else:
                enemy.update(player)

        all_clear = len(enemies) == 0

        if all_clear:
            if rooms[(room_x, room_y)].get("boss", False):
                rooms[(room_x, room_y)]["cleared"] = True
            else:
                rooms[(room_x, room_y)]["cleared"] = True

        for item in powerup_items[:]: item.update()
        picked=False
        for item in powerup_items[:]:
            if item.near_player(player) and e_pressed and not picked:
                item.apply(player); picked=True
        if picked: powerup_items.clear()

        exit_side=player_touching_exit(player)
        blocked=(exit_side is not None and exit_side==entry_side and player.safe_timer>0)
        if all_clear and exit_side and not blocked:
            rooms[(room_x,room_y)]["powerups"]=[p for p in powerup_items if p.alive]
            teleport_player(player,exit_side)
            next_room=get_next_room_position(room_x,room_y,exit_side)
            room_x,room_y=next_room
            if next_room not in rooms:
                if forced_next_room=="boss":
                    is_power = False
                    is_boss = True
                elif forced_next_room=="power":
                    is_power = True
                    is_boss = False
                else:
                    is_power = randint(1, 100) <= 25
                    is_boss = False

                if not is_power and not is_boss:
                    is_boss = should_spawn_boss()
                forced_next_room=None

                if is_boss:
                    bg = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT))
                    bg.fill((127, 255, 212))
                    boss_x, boss_y = boss_spawn_position(exit_side)
                    enemies_list = [BossEnemy(boss_x, boss_y)]
                elif is_power:
                    bg = power_bg
                    enemies_list = []
                else:
                    bg = choice(bgs)
                    enemies_list = spawn_enemies(min(20, 3 + num_of_lvl), player)

                rooms[next_room] = {
                    "cleared": False,
                    "power": is_power,
                    "boss": is_boss,
                    "background": bg,
                    "enemies": enemies_list,
                    "powerups": spawn_powerup_items() if is_power else []
                }
                if is_boss:
                    # boss zawsze jest pierwszy w liście enemies
                    start_room_intro(enemies_list[0])
                num_of_lvl+=1
            rd = rooms[next_room]
            cur_bg = rd["background"]
            enemies = [] if rd.get("cleared", False) else rd["enemies"]
            powerup_items=list(rd["powerups"])
            player.safe_timer=FPS; entry_side=exit_side

        for enemy in enemies:
            if player.hitbox.colliderect(enemy.rect) and player.safe_timer<=0:
                player.hp-=1; player.safe_timer=player.invincibility_frames
                play_sound("hit")

        if player.hp<=0:
            play_sound("die")
            return

        window.blit(cur_bg,(0,0))
        for enemy in enemies: enemy.draw(window)
        for item in powerup_items: item.draw(window,fname,fdesc)
        for slash in slashes: slash.draw(window)
        for bullet in bullets: bullet.draw(window)
        player.draw(window)

        for item in powerup_items:
            if item.near_player(player):
                item.draw_description(window,fname,fdesc)
                hint = fdesc.render(tr("Press E to pick up "), True, (180,255,180))
                window.blit(hint,(WINDOW_WIDTH//2-hint.get_width()//2,WINDOW_HEIGHT-60))

        if show_hitboxes:
            player.draw_hitbox(window)
            for enemy in enemies: enemy.draw_hitbox(window)
            for bullet in bullets: bullet.draw_hitbox(window)
            for slash in slashes:
                sx=slash.cx+slash.dir_x*slash.offset; sy=slash.cy+slash.dir_y*slash.offset
                a=math.atan2(slash.dir_y,slash.dir_x); arc=math.radians(70)
                pts=[(sx,sy)]
                for i in range(21):
                    ca=a-arc/2+(arc/20)*i
                    pts.append((sx+math.cos(ca)*slash.range,sy+math.sin(ca)*slash.range))
                pygame.draw.polygon(window,(255,255,0),pts,1)
            hb_lbl=fdesc.render("HITBOXES ON  (Shift+F2)",True,(255,255,0))
            window.blit(hb_lbl,(WINDOW_WIDTH//2-hb_lbl.get_width()//2,WINDOW_HEIGHT-30))

        draw_hud(window,player,font)
        draw_minimap(window,rooms,(room_x,room_y))
        window.blit(effect_surface,(0,0),special_flags=pygame.BLEND_RGBA_ADD)
        effect_surface.fill((0,0,0,0))

        gamma=settings["gamma"]

        if gamma!=1.0:
            shade=pygame.Surface((WINDOW_WIDTH,WINDOW_HEIGHT)).convert_alpha()
            if gamma>1.0:
                v=min(255,int(255*(gamma-1.0)*0.25))
                shade.fill((v,v,v,0))
                window.blit(shade,(0,0),special_flags=pygame.BLEND_RGB_ADD)
            else:
                v=max(0,int(255*gamma))
                shade.fill((v,v,v))
                window.blit(shade,(0,0),special_flags=pygame.BLEND_RGB_MULT)
        if show_inventory:
                    draw_inventory(window, player, font)
                    pygame.display.update()
                    continue
        pygame.display.update()

if __name__=="__main__":
    while True:
        mode=main_menu()
        main(mode=="continue")
