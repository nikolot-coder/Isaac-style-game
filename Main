import pygame
from random import randint, choice
import sys

pygame.init()

# Ustawienia ekranu
WINDOW_WIDTH = 1280
WINDOW_HEIGHT = 720
FPS = 60

window = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
pygame.display.set_caption("Isaac - Style Game")
clock = pygame.time.Clock()

# Dla testu
class Enemy:

    def __init__(self, x, y):

        self.x = x
        self.y = y
        self.width = 40
        self.height = 40
        self.speed = 2

        self.rect = pygame.Rect(
            self.x,
            self.y,
            self.width,
            self.height
        )

        # kierunek ruchu
        self.move_x = 0
        self.move_y = 0

        # timer zmiany decyzji
        self.ai_timer = randint(20, 80)

        # tryb ruchu
        self.state = choice([
            "chase",
            "strafe_left",
            "strafe_right",
            "retreat"
        ])

        # dash timer
        self.dash_timer = randint(120, 240)

    def choose_new_state(self):

        self.state = choice([
            "chase",
            "chase",
            "chase",
            "strafe_left",
            "strafe_right",
            "retreat"
        ])

        self.ai_timer = randint(25, 90)

    def update(self, player):

        self.ai_timer -= 1
        self.dash_timer -= 1

        if self.ai_timer <= 0:
            self.choose_new_state()

        # kierunek do gracza
        dx = player.x - self.x
        dy = player.y - self.y

        distance = max((dx ** 2 + dy ** 2) ** 0.5, 1)

        nx = dx / distance
        ny = dy / distance

        """Tryby ruchu"""
        # zwykły chase
        if self.state == "chase":

            self.move_x += nx * 0.4
            self.move_y += ny * 0.4

        # orbitowanie w lewo
        elif self.state == "strafe_left":

            self.move_x += -ny * 0.5
            self.move_y += nx * 0.5

        # orbitowanie wprawo
        elif self.state == "strafe_right":

            self.move_x += ny * 0.5
            self.move_y += -nx * 0.5

        # cofanie
        elif self.state == "retreat":

            self.move_x -= nx * 0.35
            self.move_y -= ny * 0.35

        # chaos
        self.move_x += randint(-10, 10) / 50
        self.move_y += randint(-10, 10) / 50

        # dash
        if self.dash_timer <= 0:

            self.move_x += nx * 10
            self.move_y += ny * 10
            self.dash_timer = randint(120, 260)

        # tarcie/opór ziemi(?)
        self.move_x *= 0.92
        self.move_y *= 0.92

        # limit speeda
        speed_length = max(
            (self.move_x ** 2 + self.move_y ** 2) ** 0.5,
            1
        )

        max_speed = self.speed
        self.move_x = (self.move_x / speed_length) * min(speed_length, max_speed)
        self.move_y = (self.move_y / speed_length) * min(speed_length, max_speed)

        # ruch
        self.x += self.move_x
        self.y += self.move_y

        # colizje mapy
        if self.x < 0:
            self.x = 0
            self.move_x *= -0.5

        if self.x + self.width > WINDOW_WIDTH:
            self.x = WINDOW_WIDTH - self.width
            self.move_x *= -0.5

        if self.y < 0:
            self.y = 0
            self.move_y *= -0.5

        if self.y + self.height > WINDOW_HEIGHT:
            self.y = WINDOW_HEIGHT - self.height
            self.move_y *= -0.5

        # update hitboxa
        self.rect = pygame.Rect(
            self.x,
            self.y,
            self.width,
            self.height
        )

    def draw(self, surface):

        pygame.draw.rect(
            surface,
            (200, 50, 50),
            self.rect
        )


class Player:
    def __init__(self, x, y):
        self.safe_timer = 0
        self.x = x
        self.y = y
        self.speed = 3
        try:
            loaded_image = pygame.image.load(".vscode/Images/postac.png")
            self.image = pygame.transform.scale(loaded_image, (48, 64))
        except:
            self.image = pygame.Surface((48, 64))
            self.image.fill((255, 0, 0))
        self.width = self.image.get_width()
        self.height = self.image.get_height()
        self.hitbox = pygame.Rect(self.x, self.y, self.width, self.height)

    def handle_input(self, keys):
        if keys[pygame.K_w]:
            self.y -= self.speed
        if keys[pygame.K_a]:
            self.x -= self.speed
        if keys[pygame.K_s]:
            self.y += self.speed
        if keys[pygame.K_d]:
            self.x += self.speed
        
        # Ograniczenie postaci na ekran
        if self.x < 0:
            self.x = 0
        if self.x + self.width > WINDOW_WIDTH:
            self.x = WINDOW_WIDTH - self.width
        if self.y < 0:
            self.y = 0
        if self.y + self.height > WINDOW_HEIGHT:
            self.y = WINDOW_HEIGHT - self.height

    def update(self):
        """Aktualizacja hitboxa"""
        self.hitbox = pygame.Rect(self.x, self.y, self.width, self.height)
        # Safe timer countdown
        if self.safe_timer > 0:
            self.safe_timer -= 1

    def draw(self, surface):
        """Rysowanie postaci"""
        surface.blit(self.image, (self.x, self.y))


def load_backgrounds():
    """Ładowanie tła"""
    backgrounds = []

    background_files = [
        ".vscode/Images/tlo0.png",
        ".vscode/Images/tlo1.png",
        ".vscode/Images/tlo2.png",
        ".vscode/Images/tlo3.png"
    ]

    for path in background_files:
        try:
            bg = pygame.image.load(path)
            bg = pygame.transform.scale(bg, (WINDOW_WIDTH, WINDOW_HEIGHT))
            backgrounds.append(bg)
        except:
            pass

    # jeśli żadne się nie załadowało
    if len(backgrounds) == 0:
        bg = pygame.Surface((WINDOW_WIDTH, WINDOW_HEIGHT))
        bg.fill((0, 0, 0))
        backgrounds.append(bg)

    return backgrounds


# czy dotyka krawędzi
def player_touching_exit(player):
    margin = 32

    center_x = player.x + player.width // 2
    center_y = player.y + player.height // 2

    # góra
    if center_y <= margin and center_x in range(int(WINDOW_WIDTH / 2) - 100, int(WINDOW_WIDTH / 2) + 100):
        player.y = WINDOW_HEIGHT - player.height - margin - 5
        return True

    # dół
    if center_y >= WINDOW_HEIGHT - margin and center_x in range(int(WINDOW_WIDTH / 2) - 100, int(WINDOW_WIDTH / 2) + 100):
        player.y = margin + 5
        return True

    # lewo
    if center_x <= margin and center_y in range(int(WINDOW_HEIGHT / 2) - 100, int(WINDOW_HEIGHT / 2) + 100):
        player.x = WINDOW_WIDTH - player.width - margin - 5
        return True

    # prawo
    if center_x >= WINDOW_WIDTH - margin and center_y in range(int(WINDOW_HEIGHT / 2) - 100, int(WINDOW_HEIGHT / 2) + 100):
        player.x = margin + 5
        return True

    return False

def spawn_enemies(count, player):

    enemies = []

    for i in range(count):

        while True:

            x = randint(50, WINDOW_WIDTH - 50)
            y = randint(50, WINDOW_HEIGHT - 50)

            # dystans od gracza
            dx = x - player.x
            dy = y - player.y

            distance = (dx ** 2 + dy ** 2) ** 0.5

            # minimum 250 px od gracza
            if distance > 250:
                enemies.append(Enemy(x, y))
                break

    return enemies



def main():
    """Główna pętla gry"""
    run = True

    # Inicjalizacja elementów gry
    player = Player((WINDOW_WIDTH // 2) - 24, (WINDOW_HEIGHT // 2) - 32)
    backgrounds = load_backgrounds()
    current_background = choice(backgrounds)

    # przykładowi wrogowie
    enemies = spawn_enemies(5, player)

    num_of_lvl=0
    while run:
        clock.tick(FPS)

        # Obsługa zdarzeń
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                run = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    run = False

        keys = pygame.key.get_pressed()
        player.handle_input(keys)

        # przytrzymanie SPACE usuwa wrogów
        if keys[pygame.K_SPACE]:

            if len(enemies) > 0:
                enemies.pop()

        # Aktualizacja
        player.update()

        # Wrogowie ruszają się dopiero po safe time
        if player.safe_timer <= 0:
            for enemy in enemies:
                enemy.update(player)

        # jeśli wszyscy wrogowie są martwi
        all_enemies_dead = len(enemies) == 0

        
        # jeśli gracz dotknie krawędzi
        if all_enemies_dead and player_touching_exit(player):

            # losuje nowe tło
            current_background = choice(backgrounds)
            num_of_lvl+=1
            player.safe_timer = FPS/2

            # nowi wrogowie
            enemies = spawn_enemies(5+num_of_lvl, player)

        window.blit(current_background, (0, 0))

        # rysuje wrogów
        for enemy in enemies:
            enemy.draw(window)

        player.draw(window)
        
        # Aktualizacja ekranu
        pygame.display.update()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()