def synergy_wind_force(p):
    p.speed += 1
    p.bullet_speed += 2

def synergy_titan_core(p):
    p.max_hp += 4
    p.hp = min(p.max_hp, p.hp + 4)

def synergy_gun_devil(p):
    p.shoot_cooldown = max(8, p.shoot_cooldown - 10)
    p.reload_duration = max(25, int(p.reload_duration * 0.75))

def synergy_risk_dealer(p):
    p.slash_damage += 3
    p.max_ammo += 2

def synergy_ice_phantom(p):
    p.speed += 0.6
    p.invincibility_frames += 10

def synergy_crimson_engine(p):
    p.heal_on_kill = True
    p.blood_pact = True
    p.heal_on_kill_amount = max(p.heal_on_kill_amount, 2)
    p.slash_damage += 1

def synergy_storm_arsenal(p):
    p.bullet_speed += 3
    p.max_ammo += 4
    p.ammo = p.max_ammo

def synergy_fortress_vow(p):
    p.max_hp += 5
    p.hp = p.max_hp
    p.speed *= 0.92

def synergy_apocalypse_core(p):
    p.slash_damage += 5
    p.max_hp = max(1, p.max_hp - 2)
    p.hp = min(p.hp, p.max_hp)
    p.speed += 1

def synergy_blizzard_knight(p):
    p.slash_range += 45
    p.slash_damage += 2
    p.invincibility_frames += 20

def synergy_thunder_blood(p):
    p.bullet_speed += 4
    p.heal_on_kill = True
    p.blood_pact = True
    p.heal_on_kill_amount = max(p.heal_on_kill_amount, 2)

def synergy_chaos_bulwark(p):
    p.max_hp += 3
    p.hp = p.max_hp
    p.chaos = True
    p.max_ammo += 3

def synergy_legend_celestial_foundry(p):
    p.max_hp += 6
    p.hp = p.max_hp
    p.bullet_speed += 3
    p.slash_damage += 2

def synergy_legend_void_ascension(p):
    p.speed += 1.2
    p.slash_damage += 4
    p.heal_on_kill = True
    p.heal_on_kill_amount = max(p.heal_on_kill_amount, 3)

